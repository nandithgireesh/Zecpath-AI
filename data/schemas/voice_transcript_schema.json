{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceTranscriptSchema",
  "description": "Standard schema for raw and normalized voice screening call transcripts in Zecpath-AI.",
  "type": "object",
  "required": [
    "session_id",
    "metadata",
    "turns"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session identifier for the voice screening call."
    },
    "metadata": {
      "type": "object",
      "required": [
        "candidate_id",
        "job_id",
        "timestamp_utc",
        "duration_seconds",
        "avg_confidence"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "description": "Unique candidate identifier."
        },
        "candidate_name": {
          "type": "string"
        },
        "job_id": {
          "type": "string",
          "description": "Target job requisition identifier."
        },
        "role_name": {
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 UTC timestamp of call initiation."
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "audio_format": {
          "type": "string",
          "default": "wav"
        },
        "sample_rate": {
          "type": "integer",
          "default": 16000
        },
        "language": {
          "type": "string",
          "default": "en"
        },
        "avg_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "call_status": {
          "type": "string",
          "enum": ["SCHEDULED", "IN_PROGRESS", "COMPLETED", "DROPPED", "FAILED"],
          "default": "COMPLETED"
        }
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "turn_id",
          "speaker",
          "raw_text",
          "start_time_ms",
          "end_time_ms",
          "confidence"
        ],
        "properties": {
          "turn_id": {
            "type": "string"
          },
          "speaker": {
            "type": "string",
            "enum": ["BOT", "CANDIDATE", "SYSTEM"]
          },
          "raw_text": {
            "type": "string"
          },
          "normalized_text": {
            "type": "string"
          },
          "start_time_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_time_ms": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "word_confidences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "word": { "type": "string" },
                "confidence": { "type": "number" },
                "start_ms": { "type": "integer" },
                "end_ms": { "type": "integer" }
              }
            }
          },
          "audio_segment_url": {
            "type": "string"
          }
        }
      }
    },
    "question_interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "interaction_id",
          "question_id",
          "category",
          "prompt_text",
          "response_raw"
        ],
        "properties": {
          "interaction_id": {
            "type": "string"
          },
          "question_id": {
            "type": "string",
            "description": "Corresponds to Day 22 Question IDs (e.g. INTRO_01, EXP_01, SKILL_ML_01, SAL_02, NP_01)."
          },
          "category": {
            "type": "string",
            "enum": [
              "Introduction",
              "Education",
              "Experience",
              "Skills",
              "Location",
              "Salary",
              "Notice period"
            ]
          },
          "prompt_text": {
            "type": "string"
          },
          "response_raw": {
            "type": "string"
          },
          "response_normalized": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "extracted_entities": {
            "type": "object"
          },
          "validation_status": {
            "type": "string",
            "enum": ["VALID", "INVALID", "CLARIFICATION_NEEDED"],
            "default": "VALID"
          }
        }
      }
    },
    "full_raw_text": {
      "type": "string"
    },
    "full_normalized_text": {
      "type": "string"
    }
  }
}
