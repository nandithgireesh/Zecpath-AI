{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIScreeningDataSchema",
  "description": "Standard schema for structured AI-processable screening data extracted from normalized transcripts.",
  "type": "object",
  "required": [
    "session_id",
    "candidate_id",
    "job_id",
    "extracted_profile",
    "category_evaluations"
  ],
  "properties": {
    "session_id": { "type": "string" },
    "candidate_id": { "type": "string" },
    "candidate_name": { "type": "string" },
    "job_id": { "type": "string" },
    "role_name": { "type": "string" },
    "evaluation_timestamp": { "type": "string", "format": "date-time" },
    "overall_audio_quality": {
      "type": "object",
      "properties": {
        "avg_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "low_confidence_turn_count": { "type": "integer", "minimum": 0 },
        "has_auditory_clarity_issues": { "type": "boolean" }
      }
    },
    "extracted_profile": {
      "type": "object",
      "properties": {
        "experience_years": { "type": ["number", "null"] },
        "skills_confirmed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notice_period_days": { "type": ["integer", "null"] },
        "is_immediate_joiner": { "type": "boolean" },
        "current_ctc_lpa": { "type": ["number", "null"] },
        "expected_ctc_lpa": { "type": ["number", "null"] },
        "ctc_negotiable": { "type": "boolean" },
        "current_location": { "type": "string" },
        "relocation_willingness": { "type": "boolean" },
        "remote_preferred": { "type": "boolean" },
        "highest_degree": { "type": "string" }
      }
    },
    "category_evaluations": {
      "type": "object",
      "description": "Keyed by Day 22 categories: Introduction, Education, Experience, Skills, Location, Salary, Notice period"
    },
    "readiness_for_scoring": {
      "type": "boolean",
      "description": "True if all mandatory categories have valid normalized data."
    }
  }
}
